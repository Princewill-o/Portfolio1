# Copy to .env locally; never put credentials in dist/ or source control.
PUBLIC_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
RESEND_API_KEY=
CHAT_OWNER_EMAIL=
# A verified Resend sending address, e.g. Portfolio <hello@your-domain.example>
CHAT_FROM_EMAIL=
# Your receiving subdomain, or the domain assigned by Resend, WITHOUT @.
CHAT_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
