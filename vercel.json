{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "node scripts/verify-deploy.mjs",
  "installCommand": "",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/api/chat/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portfolio1-sigma-lac.vercel.app"
        }
      ],
      "destination": "https://www.prwl.co.uk/:path*",
      "permanent": true
    }
  ]
}
